								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"_id\": \"b{{$timestamp}}\",\n  \"name\": \"My New Board\",\n  \"description\": \"A board created from Postman\",\n  \"workspaceId\": \"w1\",\n  \"color\": \"from-indigo-500 to-violet-500\",\n  \"columns\": [\n    { \"id\": \"c1\", \"boardId\": \"b1\", \"title\": \"To Do\", \"order\": 0, \"color\": \"#94A3B8\" },\n    { \"id\": \"c2\", \"boardId\": \"b1\", \"title\": \"Doing\", \"order\": 1, \"color\": \"#4F46E5\" },\n    { \"id\": \"c3\", \"boardId\": \"b1\", \"title\": \"Done\", \"order\": 2, \"color\": \"#16A34A\" }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/boards",
							"host": ["{{base_url}}"],
							"path": ["boards"]
						}
					},
					"response": []
				},
				{
					"name": "Update Board",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Renamed Board\",\n  \"favorite\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/boards/:id",
							"host": ["{{base_url}}"],
							"path": ["boards", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "b1"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Board",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/boards/:id",
							"host": ["{{base_url}}"],
							"path": ["boards", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "b1"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Tasks",
			"item": [{
"name": "Get All Tasks",
"request": {
"method": "GET",
"url": { "raw": "{{base_url}}/tasks", "host": ["{{base_url}}"], "path": ["tasks"] }
},
"response": []
},
{
"name": "Get Tasks by Board",
"request": {
"method": "GET",
"url": {
"raw": "{{base_url}}/tasks?boardId=b1",
"host": ["{{base_url}}"],
"path": ["tasks"],
"query": [{ "key": "boardId", "value": "b1" }]
}
},
"response": []
},
{
